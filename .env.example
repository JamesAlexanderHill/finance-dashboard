# Web server port (dev and production). BETTER_AUTH_URL must use the same port.
PORT=5025

DATABASE_URL=postgres://finance:finance@localhost:54329/finance

# RustFS (S3-compatible, private)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=finance-source-files
S3_ACCESS_KEY_ID=finance
S3_SECRET_ACCESS_KEY=finance-secret

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:5025
# Passkey relying party (domain only, no scheme/port)
PASSKEY_RP_ID=localhost
PASSKEY_RP_NAME=Finance
# Comma-separated emails allowed to register. Empty = anyone.
ALLOWED_SIGNUP_EMAILS=

# Mailgun (email OTP). When unset, OTP codes are printed to the web server log.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM=
# https://api.mailgun.net or https://api.eu.mailgun.net
MAILGUN_BASE_URL=https://api.mailgun.net
