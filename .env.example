# Postgres (docker-compose.yml exposes it on host port 5332)
DATABASE_URL=postgresql://dev:development@localhost:5332/db
POSTGRES_USER=dev
POSTGRES_PASSWORD=development
POSTGRES_DB=db

# Better Auth
# Generate a 32+ char secret, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=replace-me-with-a-32-char-secret
# Base URL of the app (used to build magic-link URLs and as the passkey origin)
BETTER_AUTH_URL=http://localhost:3000
# Passkey relying-party ID — the registrable domain (no scheme/port).
# Use your apex domain in production, e.g. example.com
PASSKEY_RP_ID=localhost

# Sign-in methods (see src/core/config/env.ts) — each defaults to enabled;
# set to "false" to disable a method an application doesn't want.
# AUTH_MAGIC_LINK_ENABLED=true
# AUTH_PASSKEY_ENABLED=true

# Single sign-on: a JSON array of externally-hosted identity providers, e.g.
# [{"providerId":"okta","clientId":"...","clientSecret":"...","discoveryUrl":"https://your-org.okta.com/.well-known/openid-configuration"}]
# Unset or "[]" disables SSO entirely.
# AUTH_SSO_PROVIDERS_JSON=[]

# Object storage for raw import uploads (imports feature). Optional — only
# required to import PDF statements; canonical-CSV imports work without it.
# Works with AWS S3, Cloudflare R2, MinIO, etc.
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false
